{
	"name": "pi-ate-scheduler",
	"version": "1.0.2",
	"description": "Timer and recurring task extension for pi-coding-agent",
	"main": "index.ts",
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.0.0"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	},
	"optionalDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.0.0"
	},
	"pi": {
		"extensions": [
			"."
		]
	},
	"files": [
		"*.ts",
		"tests/",
		"README.md",
		"README.en.md",
		"tsconfig.json",
		"vitest.config.ts",
		"package.json"
	],
	"devDependencies": {
		"@vitest/coverage-v8": "^3.2.4",
		"vitest": "^3.0.0",
		"typescript": "^6.0.3"
	},
	"keywords": [
		"pi-package"
	],
	"homepage": "https://catlain.github.io/pi-atelier/",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com:catlain/pi-scheduler.git"
	},
	"bugs": {
		"url": "https://github.com/catlain/pi-scheduler/issues"
	},
	"license": "MIT"
}
